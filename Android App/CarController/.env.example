# Build-time defaults for the car app.
#
# Expo inlines EXPO_PUBLIC_* variables into the JS bundle, so treat the token
# here as "baked into the APK", not as a secret. Anything typed into the app's
# relay settings sheet is stored with expo-secure-store and overrides these.
#
# Copy to .env before `npx expo run:android` / `eas build`.
#
# The room must match the operator app's room, and the token must match the
# relay stack's RELAY_TOKEN.

EXPO_PUBLIC_RELAY_URL=wss://car.your-guide.co/car-ws
EXPO_PUBLIC_RELAY_TOKEN=
EXPO_PUBLIC_RELAY_ROOM=default
